{
  "name": "examprep",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted exam practice app: exam and study modes, spaced repetition, offline PWA",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite web",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "start": "node server/main.ts",
    "test": "node --test 'shared/*.test.ts' 'server/*.test.ts' 'web/src/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@preact/signals": "^2.11.3",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "openid-client": "^6.8.8",
    "preact": "^11.0.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "oauth2-mock-server": "^8.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
